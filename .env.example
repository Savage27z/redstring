# redstring.lol
#
# Everything here is OPTIONAL for local dev. With no .env at all the app runs on
# an in-memory board and applies bids without payment, so you can exercise the
# outbid -> reflow -> realtime loop immediately.

# --- board rules -----------------------------------------------------------
NEXT_PUBLIC_MIN_BID=5

# --- payments: Polar (required in production) -------------------------------
# Polar is the merchant of record. Without POLAR_ACCESS_TOKEN + POLAR_PRODUCT_ID,
# /api/checkout refuses to run in production.
#
# 1. Create an organization at polar.sh (use sandbox.polar.sh to test first).
# 2. Create ONE product, named for whatever the buyer should see on the receipt,
#    e.g. "Board placement". Its catalog price is irrelevant: every checkout
#    attaches a one-off fixed price equal to that bid, so the buyer cannot
#    change the amount.
# 3. Settings -> Developers -> create an Organization Access Token.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=

# "sandbox" (default) or "production". Defaults to sandbox on purpose: going
# live has to be a deliberate act, not a forgotten variable.
POLAR_SERVER=sandbox

# Settings -> Webhooks -> add endpoint https://<your-domain>/api/webhooks/polar
# Subscribe to `order.paid` and copy the signing secret here.
POLAR_WEBHOOK_SECRET=

# Used to build the post-payment return URL. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://redstring.lol

# --- persistence (optional) -------------------------------------------------
# Set this and run schema.sql; the Postgres adapter takes over automatically.
# Verify with: npm run db:check
DATABASE_URL=

# Managed Postgres usually needs relaxed TLS verification. Set to "false" only
# if your provider presents a chain Node already trusts.
DATABASE_SSL=true

# --- safety switches --------------------------------------------------------
# With Polar unconfigured, non-production builds apply bids WITHOUT payment so
# the outbid -> reflow -> realtime loop stays demoable. Set to 0 to refuse.
ALLOW_DEV_BIDS=1

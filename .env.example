# redstring.lol
#
# Everything here is OPTIONAL for local dev. With no .env at all the app runs on
# an in-memory board and applies bids without payment, so you can exercise the
# outbid -> reflow -> realtime loop immediately.

# --- board rules -----------------------------------------------------------
NEXT_PUBLIC_MIN_BID=2

# --- payments: crypto (USDC) ------------------------------------------------
# Bids settle in USDC on Solana and/or Base. USDC is a dollar stablecoin, so a
# $12 bid is exactly 12 USDC — no price oracle, no volatility window.
#
# A rail is OFF until its recipient address is set. Set one or both.
# These are the wallets the money lands in, so double-check them.
SOLANA_RECIPIENT=
BASE_RECIPIENT=

# "testnet" (default) or "mainnet". Testnet by default on purpose: taking real
# money has to be a deliberate act, not a forgotten variable. On testnet this
# uses Solana devnet and Base Sepolia, and their faucet USDC.
CRYPTO_NETWORK=testnet

# Public RPCs work but are heavily rate limited. For anything real, use a
# provider (Helius, QuickNode, Alchemy) — the poll loop hits these per viewer.
SOLANA_RPC_URL=
BASE_RPC_URL=

# Only set these to override the USDC contract for a custom network.
# SOLANA_USDC_MINT=
# BASE_USDC_ADDRESS=

# Used for absolute URLs. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://redstring.lol

# --- persistence (optional) -------------------------------------------------
# Set this and run schema.sql; the Postgres adapter takes over automatically.
# Verify with: npm run db:check
DATABASE_URL=

# Managed Postgres usually needs relaxed TLS verification. Set to "false" only
# if your provider presents a chain Node already trusts.
DATABASE_SSL=true

# --- safety switches --------------------------------------------------------
# With no chain configured, non-production builds apply bids WITHOUT payment so
# the outbid -> reflow -> realtime loop stays demoable. Set to 0 to refuse.
ALLOW_DEV_BIDS=1

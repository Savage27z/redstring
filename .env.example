# redstring.lol
#
# Everything here is OPTIONAL for local dev. With no .env at all the app runs on
# an in-memory board and applies bids without payment, so you can exercise the
# outbid -> reflow -> realtime loop immediately.

# --- board rules -----------------------------------------------------------
NEXT_PUBLIC_MIN_BID=5

# --- payments (required in production) -------------------------------------
# Without STRIPE_SECRET_KEY, /api/checkout refuses to run in production.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe return URLs. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://redstring.lol

# --- persistence (optional) -------------------------------------------------
# Set this and run schema.sql, then swap the marked functions in src/lib/store.ts.
DATABASE_URL=

# --- safety switches --------------------------------------------------------
# With no STRIPE_SECRET_KEY, non-production builds apply bids WITHOUT payment so
# the outbid -> reflow -> realtime loop is demoable. Set to 0 to refuse instead.
ALLOW_DEV_BIDS=1

# Managed Postgres usually needs relaxed TLS verification. Set to "false" only
# if your provider presents a chain Node already trusts.
DATABASE_SSL=true
